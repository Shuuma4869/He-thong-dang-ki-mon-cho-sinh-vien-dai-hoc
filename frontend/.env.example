# Template env cho frontend Vite cua du an "He thong dang ky mon hoc".
#
# Cong nghe frontend:
# - React 19
# - TypeScript 5.8
# - Vite 6
# - Tailwind CSS 4
# - lucide-react
# - npm
#
# Can cai truoc khi chay frontend:
# - Node.js 20 tro len
# - npm 10 tro len
#
# Cach dung:
# 1. Copy file nay thanh .env.local trong thu muc frontend/.
# 2. Dien gia tri that neu tinh nang can dung.
# 3. Khong commit .env.local len GitHub.

# URL backend local du kien khi ket noi API that o phase sau.
VITE_API_BASE_URL=http://localhost:8080/api
